@using ContentModels = Umbraco.Cms.Web.Common.PublishedModels;
@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage<ContentModels.Article>
@inject Asm.AmCom.Web.Data.IContentDateService ContentDates
@{
    Layout = "FullPageLayout.cshtml";
    ViewBag.Title = $"{Model.Value("title")} - Andrew McLachlan";
    ViewBag.Description = Model.Value("description");
    ViewBag.Canonical = Model.Url();
    ViewBag.PageType = "article";

    var dates = ContentDates.Get(Model.Id);
    // CreateDate is only the fallback for something never published: it's when the node was created, which
    // for an article drafted over several days is earlier than it actually went live.
    var published = dates?.FirstPublished ?? Model.CreateDate;
    // Null where no body change is on record — either the article hasn't been revised since this was
    // introduced, or version history had been pruned past the point of proving one. No update is claimed.
    var lastContentChange = dates?.LastContentChange;
    var showUpdated = lastContentChange is { } changed && changed.Date > published.Date;
}

@section PageLink
{
    @if (Model.PageLinks != null)
    {
        <section class="page-links">
            @foreach (var pageLink in Model.PageLinks)
            {
                await Html.RenderPartialAsync("PageLink", pageLink.Content);
            }
        </section>
    }
}

<p class="article-dates">
    <span class="published">@(showUpdated ? "First Published" : String.Empty) <time datetime="@published.ToString("yyyy-MM-dd")">@published.ToString("d MMMM yyyy")</time></span>
    @if (showUpdated)
    {
        <span class="updated">Updated <time datetime="@lastContentChange!.Value.ToString("yyyy-MM-dd")">@lastContentChange!.Value.ToString("d MMMM yyyy")</time></span>
    }
</p>

@Model.Value("pageContent")

@section Scripts
{
    <script type="application/ld+json">
        {
            "@@context": "https://schema.org",
            "@@type": "Article",
            "headline": "@Html.Raw(Model.Value<string>("title")?.Replace("\"", "\\\""))",
            "description": "@Html.Raw(Model.Value<string>("description")?.Replace("\"", "\\\""))",
            "url": "@ViewBag.Canonical",
            "datePublished": "@published.ToString("yyyy-MM-dd")",
            "dateModified": "@(showUpdated ? lastContentChange!.Value.ToString("yyyy-MM-dd") : published.ToString("yyyy-MM-dd"))",
            "author": {
                "@@type": "Person",
                "name": "Andrew McLachlan",
                "url": "https://andrewmclachlan.com"
            }
        }
    </script>
}